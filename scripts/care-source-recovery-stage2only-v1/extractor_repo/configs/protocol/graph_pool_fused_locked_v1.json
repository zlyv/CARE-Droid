{
  "schema_version": "1.0.0",
  "protocol_id": "TASA_GRAPH_POOL_FUSED_LOCKED_V1",
  "status": "CANDIDATE_LOCKED_NOT_FORMAL",
  "model": "graph_pool_compact_fused_logistic",
  "graph_summary": {
    "node_statistics": ["mean", "max", "std"],
    "edge_statistics": ["mean"],
    "graph_statistics": ["log1p_node_count", "log1p_edge_count"],
    "include_reliability": true,
    "role_vocabulary_size": 31
  },
  "reliability": {
    "components": ["D", "T", "one_minus_F"],
    "weights": {"D": 1.0, "T": 1.0, "one_minus_F": 1.0},
    "alpha_prior": 1.0,
    "kappa_support": 20.0,
    "kappa_context": 20.0,
    "r_min": 0.1,
    "r_max": 0.95,
    "fit_scope": "outer_training_partition_only"
  },
  "compact_features": {
    "schema_source": "feature_schema.json",
    "audit_columns_excluded": true,
    "constant_filter_scope": "outer_training_partition_only",
    "standardization_scope": "outer_training_partition_only"
  },
  "classifier": {
    "type": "l2_logistic_regression",
    "iterations": 1500,
    "learning_rate": 0.05,
    "l2": 0.001,
    "seeds": [0, 1, 2, 3, 4]
  },
  "decision": {
    "threshold": 0.5,
    "threshold_selection": "fixed_predeclared",
    "per_year_threshold_tuning": false
  },
  "formalization_blockers": [
    "audited_first_seen_utc_not_joined",
    "formal_feature_schema_not_locked_for_new_dataset",
    "tif_predictions_not_available_for_paired_comparison"
  ]
}
